{
  "name": "vibe-lingo",
  "version": "0.7.9",
  "description": "Work-first multilingual coaching, selected-text translation, and evidence-based review for Synergy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EricSanchezok/vibe-lingo.git"
  },
  "homepage": "https://github.com/EricSanchezok/vibe-lingo#readme",
  "bugs": {
    "url": "https://github.com/EricSanchezok/vibe-lingo/issues"
  },
  "keywords": [
    "synergy",
    "language-learning",
    "translation",
    "coaching",
    "spaced-review"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "synergy-plugin dev",
    "typecheck": "tsc --noEmit",
    "test": "synergy-plugin test",
    "build": "synergy-plugin build",
    "validate": "synergy-plugin validate --runtime-discovery",
    "pack": "synergy-plugin pack",
    "sign": "synergy-plugin sign",
    "entry": "synergy-plugin entry",
    "publish:market": "synergy-plugin publish-market --repo https://github.com/EricSanchezok/vibe-lingo",
    "release:check": "bun run typecheck && bun run test && bun run build && bun run validate && bun run pack"
  },
  "dependencies": {
    "@ericsanchezok/synergy-plugin": "^3.0.11",
    "solid-js": "^1.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ericsanchezok/synergy-plugin-kit": "^3.0.11",
    "@happy-dom/global-registrator": "^20.0.11",
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
